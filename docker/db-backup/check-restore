#!/bin/sh
# Restaure le dernier dump dans une base temporaire, compare le nombre de tables avec la base réelle
# puis le nombre de lignes de chaque table avec celui relevé juste avant le dump (fichier .counts)
set -u

vDir="${BACKUP_DIR:-/backups}"
vDump=$(ls -1t "$vDir"/nas-monitor-*.dump 2> /dev/null | head -n 1)
[ -z "$vDump" ] && { echo "Aucun dump à vérifier" >&2; exit 2; }
vScratch="restore_check_$$"
vCountsFile="${vDump%.dump}.counts"
# Une table peut perdre des lignes entre le relevé et le dump (purges) : au-delà de 10 % de perte, c'est signalé
LOSS_NUMERATOR=9

nb_tables() {
    psql -tA -d "$1" -c "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public'"
}

vError=""
if ! createdb "$vScratch" 2> /tmp/restore.err; then
    vError="création de la base temporaire impossible"
elif ! pg_restore --no-owner --exit-on-error -d "$vScratch" "$vDump" 2> /tmp/restore.err; then
    vError="pg_restore en échec"
else
    vExpected=$(nb_tables "$PGDATABASE")
    vRestored=$(nb_tables "$vScratch")
    if [ -z "$vRestored" ] || [ "$vRestored" -eq 0 ] || [ "$vRestored" != "$vExpected" ]; then
        vError="tables restaurées : ${vRestored:-0}, attendues : ${vExpected:-?}"
    elif [ -f "$vCountsFile" ]; then
        vLost=$(sh "$(dirname "$0")/row-counts" "$vScratch" > /tmp/restored.counts 2> /dev/null; \
            while read -r vTable vBefore; do
                vAfter=$(awk -v t="$vTable" '$1 == t { print $2 }' /tmp/restored.counts)
                if [ -z "$vAfter" ] || [ $((vAfter * 10)) -lt $((vBefore * LOSS_NUMERATOR)) ]; then
                    printf '%s (%s au lieu de %s) ' "$vTable" "${vAfter:-absente}" "$vBefore"
                fi
            done < "$vCountsFile")
        [ -n "$vLost" ] && vError="lignes manquantes : $vLost"
    fi
fi
dropdb --if-exists "$vScratch" 2> /dev/null

if [ -n "$vError" ]; then
    echo "Restauration en échec ($(basename "$vDump")) : $vError $(tail -c 200 /tmp/restore.err | tr -d '"\\\r' | tr '\n' ' ')" >&2
    exit 1
fi
echo "Restauration vérifiée : $(basename "$vDump"), $vRestored tables"
