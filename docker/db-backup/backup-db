#!/bin/sh
# Sauvegarde périodique de la base, signalée à nas-monitor par un ping de début et un ping de fin
set -u

ping_monitor() {
    [ -z "$DB_BACKUP_PING_URL" ] && return 0
    wget -q -O /dev/null -T 10 --header 'Content-Type: application/json' --post-data "$2" "$DB_BACKUP_PING_URL$1" \
        || echo "Ping $1 impossible" >&2
}

# Vérifie la restauration tous les DB_RESTORE_CHECK_EVERY dumps (0 : jamais) et signale le résultat
restore_check() {
    [ "${DB_RESTORE_CHECK_EVERY:-0}" -le 0 ] && return 0
    vCount=$(cat /backups/.restore-count 2> /dev/null || echo 0)
    vCount=$((vCount + 1))
    echo "$vCount" > /backups/.restore-count
    [ $((vCount % DB_RESTORE_CHECK_EVERY)) -ne 0 ] && return 0
    vUrl="${DB_RESTORE_PING_URL:-}"
    [ -n "$vUrl" ] && wget -q -O /dev/null -T 10 --post-data '{}' "$vUrl/start" 2> /dev/null
    if vResult=$(sh /scripts/check-restore 2>&1); then
        echo "$vResult"
        [ -n "$vUrl" ] && wget -q -O /dev/null -T 10 --header 'Content-Type: application/json' --post-data "{\"message\":\"$(echo "$vResult" | tr -d '"\\')\"}" "$vUrl"
    else
        echo "$vResult" >&2
        [ -n "$vUrl" ] && wget -q -O /dev/null -T 10 --header 'Content-Type: application/json' --post-data "{\"message\":\"$(echo "$vResult" | tr -d '"\\' | tr '\n' ' ')\"}" "$vUrl/fail"
    fi
}

while true; do
    vStart=$(date +%s)
    vFile="/backups/nas-monitor-$(date -u +%Y%m%d-%H%M%S).dump"
    ping_monitor /start '{}'

    # Nombre de lignes par table juste avant le dump : le test de restauration le compare
    sh /scripts/row-counts > "${vFile%.dump}.counts" 2> /dev/null || rm -f "${vFile%.dump}.counts"

    if pg_dump --format=custom --file="$vFile.tmp" 2> /tmp/pg_dump.err && mv "$vFile.tmp" "$vFile"; then
        vSize=$(wc -c < "$vFile" | tr -d ' ')
        vDurationMs=$(( ($(date +%s) - vStart) * 1000 ))
        ping_monitor '' "{\"duration_ms\":$vDurationMs,\"size_bytes\":$vSize,\"message\":\"$(basename "$vFile")\"}"
        echo "Sauvegarde terminée : $vFile ($vSize octets)"
        ls -1t /backups/nas-monitor-*.dump | tail -n +$((DB_BACKUP_KEEP + 1)) | xargs -r rm -f
        # Les fichiers de comptage sans dump correspondant sont supprimés avec les anciens dumps
        for vCounts in /backups/nas-monitor-*.counts; do
            [ -e "${vCounts%.counts}.dump" ] || rm -f "$vCounts"
        done
        restore_check
    else
        rm -f "$vFile.tmp" "${vFile%.dump}.counts"
        vMessage=$(tail -c 300 /tmp/pg_dump.err | tr -d '"\\\r' | tr '\n' ' ')
        ping_monitor /fail "{\"message\":\"pg_dump en échec : $vMessage\"}"
        echo "Sauvegarde en échec : $vMessage" >&2
    fi

    sleep "$DB_BACKUP_INTERVAL_SECONDS"
done
