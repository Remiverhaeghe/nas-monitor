{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - nas-monitor{% endblock %}

{% block body %}
    <div class="title-bar">
        <h1>Moniteurs</h1>
        <a class="button" href="{{ path('app_monitor_new') }}">Nouveau moniteur</a>
    </div>

    <ul class="summary">
        {% for status in enum('App\\Enum\\MonitorStatus').cases() %}
            <li>{{ include('_status.html.twig', {status: status}) }} {{ counts[status.value] }}</li>
        {% endfor %}
    </ul>

    {% if monitors is empty %}
        <p class="muted">Aucun moniteur pour l'instant.</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Statut</th>
                        <th>Dernier ping</th>
                        <th>Intervalle</th>
                        <th>En panne depuis</th>
                    </tr>
                </thead>
                <tbody>
                    {% for monitor in monitors %}
                        {% set incident = open_incidents[monitor.id] ?? null %}
                        <tr>
                            <td><a href="{{ path('app_monitor_show', {id: monitor.id}) }}">{{ monitor.name }}</a></td>
                            <td>{{ include('_status.html.twig', {status: monitor.status}) }}</td>
                            <td>{{ monitor.lastPingAt ? monitor.lastPingAt|date : '-' }}</td>
                            <td>{{ (monitor.expectedIntervalSeconds / 60)|round }} min</td>
                            <td>{{ incident ? incident.startedAt|date : '-' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
