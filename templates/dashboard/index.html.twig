{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - nas-monitor{% endblock %}

{% block body %}
    <div class="title-bar">
        <h1>Moniteurs</h1>
        <a class="button" href="{{ path('app_monitor_new') }}">Nouveau moniteur</a>
    </div>

    {% for maintenance in active_maintenances %}
        {% set window = maintenance.window %}
        <p class="maintenance-banner">
            Maintenance en cours jusqu'au {{ maintenance.ends_at|date }}
            ({{ window.monitor ? window.monitor.name : 'tous les moniteurs' }}) : {{ window.reason }}. Aucune alerte n'est envoyée.
        </p>
    {% endfor %}

    <ul class="summary">
        {% for status in enum('App\\Enum\\MonitorStatus').cases() %}
            <li>{{ include('_status.html.twig', {status: status}) }} {{ counts[status.value] }}</li>
        {% endfor %}
    </ul>

    {% if groups is empty %}
        <p class="muted">Aucun moniteur pour l'instant.</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Statut</th>
                        <th>Dernier ping</th>
                        <th>Intervalle</th>
                        <th>En panne depuis</th>
                        <th>Disponibilité 7 j</th>
                    </tr>
                </thead>
                {% for group in groups %}
                <tbody>
                    {% if groups|length > 1 or group.name is not null %}
                        <tr class="group-row">
                            <th colspan="6" scope="rowgroup">{{ group.name ?? 'Sans groupe' }}</th>
                        </tr>
                    {% endif %}
                    {% for monitor in group.monitors %}
                        {% set incident = open_incidents[monitor.id] ?? null %}
                        {% set monitor_availability = availability[monitor.id] ?? null %}
                        <tr>
                            <td><a href="{{ path('app_monitor_show', {id: monitor.id}) }}">{{ monitor.name }}</a></td>
                            <td>{{ include('_status.html.twig', {status: monitor.status}) }}</td>
                            <td>{{ monitor.lastPingAt ? monitor.lastPingAt|date : '-' }}</td>
                            <td>{{ (monitor.expectedIntervalSeconds / 60)|round }} min</td>
                            <td>{{ incident ? incident.startedAt|date : '-' }}</td>
                            <td>{{ monitor_availability is null ? '-' : monitor_availability|number_format(1, ',', ' ') ~ ' %' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                {% endfor %}
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block live_updates %}{{ turbo_stream_from(constant('App\\EventListener\\LiveUpdatePublisher::TOPIC'), true) }}{% endblock %}
