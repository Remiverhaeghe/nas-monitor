{% extends 'base.html.twig' %}

{% block title %}{{ title }} - nas-monitor{% endblock %}

{% block body %}
    <p>
        {% if monitor is defined %}
            <a href="{{ path('app_monitor_show', {id: monitor.id}) }}">Retour au moniteur</a>
        {% else %}
            <a href="{{ path('app_dashboard') }}">Tous les moniteurs</a>
        {% endif %}
    </p>
    <h1>{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'stacked'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}
