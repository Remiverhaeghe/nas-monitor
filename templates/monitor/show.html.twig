{% extends 'base.html.twig' %}

{% block title %}{{ monitor.name }} - nas-monitor{% endblock %}

{% block body %}
    <p><a href="{{ path('app_dashboard') }}">Tous les moniteurs</a></p>
    <h1>{{ monitor.name }}</h1>

    {% for token in app.flashes('ping_token') %}
        {% set ping_url = url('ping', {token: token}) %}
        <div class="token" id="ping-token" data-turbo-permanent>
            <p><strong>Jeton de ping</strong> : il n'est affiché qu'une seule fois, copie-le maintenant.</p>
            <pre>{{ token }}</pre>
            <p>À appeler en fin de tâche :</p>
            <pre>curl -fsS -m 10 --retry 3 -X POST {{ ping_url }}</pre>
            <p class="muted">Variantes : <code>{{ ping_url }}/start</code> au début, <code>{{ ping_url }}/fail</code> en cas d'échec.</p>
        </div>
    {% endfor %}

    <div class="actions">
        <a class="button" href="{{ path('app_monitor_edit', {id: monitor.id}) }}">Modifier</a>
        {% if monitor.paused %}
            {{ include('monitor/_action.html.twig', {route: 'app_monitor_resume', label: 'Reprendre'}) }}
        {% else %}
            {{ include('monitor/_action.html.twig', {route: 'app_monitor_pause', label: 'Mettre en pause'}) }}
        {% endif %}
        {% if not monitor.type.active %}
            {{ include('monitor/_action.html.twig', {route: 'app_monitor_rotate_token', label: 'Régénérer le jeton', confirm: 'L\'ancien jeton cessera immédiatement de fonctionner. Continuer ?'}) }}
        {% endif %}
        {{ include('monitor/_action.html.twig', {route: 'app_monitor_delete', label: 'Supprimer', danger: true, confirm: 'Le moniteur et tout son historique seront supprimés. Continuer ?'}) }}
    </div>

    <dl class="details">
        <dt>Statut</dt>
        <dd>{{ include('_status.html.twig', {status: monitor.status}) }}</dd>
        <dt>Type</dt>
        <dd>{{ monitor.type.label }}</dd>
        {% if monitor.target %}
            <dt>Cible</dt>
            <dd>{{ monitor.target }}</dd>
        {% endif %}
        <dt>Intervalle attendu</dt>
        <dd>{{ (monitor.expectedIntervalSeconds / 60)|round }} min</dd>
        <dt>Délai de grâce</dt>
        <dd>{{ (monitor.graceSeconds / 60)|round }} min</dd>
        <dt>Dernier signal</dt>
        <dd>{{ monitor.lastPingAt ? monitor.lastPingAt|date : 'aucun' }}</dd>
        <dt>Alertes</dt>
        <dd>{{ monitor.notificationChannel.label }}</dd>
        <dt>Créé le</dt>
        <dd>{{ monitor.createdAt|date }}</dd>
    </dl>

    {% if duration_chart or size_chart %}
        <h2>Tendances</h2>
        <div class="trends">
            {% if duration_chart %}
                {{ include('monitor/_trend.html.twig', {chart: duration_chart, title: 'Durée des exécutions réussies (s)'}) }}
            {% endif %}
            {% if size_chart %}
                {{ include('monitor/_trend.html.twig', {chart: size_chart, title: 'Taille sauvegardée (Mo)'}) }}
            {% endif %}
        </div>
    {% endif %}

    <h2>Incidents</h2>
    {% if incidents is empty %}
        <p class="muted">Aucun incident.</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Cause</th>
                    </tr>
                </thead>
                <tbody>
                    {% for incident in incidents %}
                        <tr>
                            <td>{{ incident.startedAt|date }}</td>
                            <td>{{ incident.resolvedAt ? incident.resolvedAt|date : 'en cours' }}</td>
                            <td>{{ incident.cause.label }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <h2>Derniers pings</h2>
    {% if pings is empty %}
        <p class="muted">Aucun ping reçu.</p>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Reçu le</th>
                        <th>Type</th>
                        <th>Durée</th>
                        <th>Taille</th>
                        <th>Message</th>
                        <th>Origine</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ping in pings %}
                        <tr>
                            <td>{{ ping.receivedAt|date('d/m/Y H:i:s') }}</td>
                            <td>{{ ping.kind.label }}</td>
                            <td>{{ ping.durationMs is not null ? (ping.durationMs / 1000)|number_format(1, ',', ' ') ~ ' s' : '-' }}</td>
                            <td>{{ ping.sizeBytes is not null ? (ping.sizeBytes / 1048576)|number_format(1, ',', ' ') ~ ' Mo' : '-' }}</td>
                            <td class="wrap">
                                {{ ping.message ?? '-' }}
                                {% if ping.anomaly %}<br><span class="anomaly">Anomalie : {{ ping.anomaly }}</span>{% endif %}
                            </td>
                            <td>{{ ping.sourceIp ?? '-' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block live_updates %}{{ turbo_stream_from(constant('App\\EventListener\\LiveUpdatePublisher::TOPIC'), true) }}{% endblock %}
