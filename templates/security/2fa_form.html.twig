{% extends 'base.html.twig' %}

{% block title %}Code de vérification - nas-monitor{% endblock %}

{% block body %}
    <form class="login" method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}">
        <h1>Code de vérification</h1>
        <p class="muted">Saisis le code à six chiffres affiché par ton application d'authentification.</p>

        {% if authenticationError %}
            <p class="error">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</p>
        {% endif %}

        <label for="_auth_code">Code</label>
        <input type="text" id="_auth_code" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*" required autofocus>

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <button type="submit">Valider</button>
        <p><a href="{{ logoutPath }}">Annuler</a></p>
    </form>
{% endblock %}
