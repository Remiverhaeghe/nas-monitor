# Modèle du fichier .env.nas, à créer sur le NAS à côté de compose.prod.yaml et à ne jamais commiter.
# Lancement : docker compose --env-file .env.nas -f compose.yaml -f compose.prod.yaml up -d
# Chaque valeur se génère avec : openssl rand -base64 32

# Secret de l'application Symfony
APP_SECRET=
# Chiffrement des secrets TOTP : 32 octets en base64
TOTP_ENCRYPTION_KEY=
# Signature des jetons du hub Mercure
CADDY_MERCURE_JWT_SECRET=
# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=

# Facultatif, les valeurs ci-dessous sont les défauts de compose.prod.yaml
# SERVER_NAME=nas-monitor.exemple.fr
# HTTPS_PORT=443
# DB_BACKUP_INTERVAL_SECONDS=86400
# DB_BACKUP_KEEP=14
